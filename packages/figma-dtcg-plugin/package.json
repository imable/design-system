{
  "name": "@mimir/figma-dtcg-plugin",
  "version": "0.3.3",
  "private": "true",
  "description": "Exports Figma variables.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && npm run build:main -- --minify",
    "build:main": "esbuild ./src/index.ts --target=es2017 --bundle --outfile=dist/index.js",
    "build:ui": "vite build --minify esbuild --emptyOutDir=false",
    "watch": "npm run build -- --watch"
  },
  "author": "",
  "license": "",
  "dependencies": {
    "@mimir/figma-to-dtcg": "workspace:*"
  },
  "devDependencies": {
    "@figma/plugin-typings": "*",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
